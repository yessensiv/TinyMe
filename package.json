{
  "name": "myroom",
  "version": "0.33.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:functions": "supabase functions serve music-library",
    "local:env": "node scripts/local-env.mjs",
    "db:migrate": "supabase migration up --local",
    "admin:grant": "node --env-file=.env.local scripts/set-admin.mjs",
    "test:auth": "tsx --test tests/integration/auth.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pixi.js": "^8.14.0",
    "lucide-react": "^0.468.0",
    "@supabase/supabase-js": "^2.95.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "supabase": "2.121.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0"
  },
  "engines": { "node": ">=24" }
}
